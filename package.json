{
  "name": "tollstile-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './examples/*' typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/node": "^22.18.0",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
