{
  "name": "@tollstile/express",
  "version": "0.1.2",
  "description": "Express middleware to charge per API call with x402, MPP, credits, and subscriptions. Holds the response until payment settles.",
  "keywords": [
    "express",
    "express-middleware",
    "x402",
    "x402-express",
    "mpp",
    "agent-payments",
    "api-monetization",
    "paid-api",
    "pay-per-call",
    "payment-middleware"
  ],
  "homepage": "https://tollstile.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tollstile/tollstile.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/tollstile/tollstile/issues"
  },
  "author": "Paradigm AI Inc.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "tollstile": "workspace:^"
  },
  "devDependencies": {
    "express": "5.2.1",
    "@types/express": "5.0.6",
    "tollstile": "workspace:^"
  }
}
