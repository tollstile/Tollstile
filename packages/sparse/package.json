{
  "name": "@tollstile/sparse",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental: sparse (probabilistic) settlement as a Tollstile rail, with an in-memory facilitator implementing commit\u2013reveal. Reference implementation for \u201cWhen Not to Settle Probabilistically\u201d. Not published.",
  "keywords": [
    "tollstile",
    "sparse-settlement",
    "probabilistic-payments",
    "x402",
    "experimental"
  ],
  "homepage": "https://tollstile.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tollstile/tollstile.git",
    "directory": "packages/sparse"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "gas": "tsx scripts/gas-benchmark.ts",
    "verify-live": "tsx scripts/verify-live.ts"
  },
  "peerDependencies": {
    "tollstile": "workspace:^"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "solc": "0.8.37",
    "tollstile": "workspace:^",
    "tsx": "4.23.13",
    "viem": "2.56.8"
  }
}
